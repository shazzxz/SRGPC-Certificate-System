# Google Sign-In (required for student login/registration)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Public Render URL used for OAuth callback generation
SRGPC_PUBLIC_BASE_URL=https://srgpc-certificate-system.onrender.com

# Production security
SRGPC_SESSION_KEY=generate-a-long-random-secret

# Optional shared rate-limit store (recommended when running more than one instance)
SRGPC_RATE_LIMIT_STORAGE_URI=redis://...

# Optional S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO)
SRGPC_S3_BUCKET=srgpc-production
SRGPC_S3_ENDPOINT=https://...
SRGPC_S3_ACCESS_KEY=...
SRGPC_S3_SECRET_KEY=...
SRGPC_S3_REGION=auto
SRGPC_S3_PREFIX=srgpc

# Backup job
SRGPC_BACKUP_BUCKET=srgpc-production-backups
SRGPC_BACKUP_PREFIX=postgres
SRGPC_BACKUP_RETENTION_DAYS=30
