# SMTP settings required for student Gmail verification
# For Gmail SMTP, use an App Password, not your normal Google password.
SRGPC_SMTP_HOST=smtp.gmail.com
SRGPC_SMTP_PORT=587
SRGPC_SMTP_USER=your-verification-gmail@gmail.com
SRGPC_SMTP_PASSWORD=your-16-character-app-password
SRGPC_SMTP_FROM=your-verification-gmail@gmail.com
SRGPC_SMTP_SSL=0

# Optional: set this to the public Render URL to make verification links explicit.
# SRGPC_PUBLIC_BASE_URL=https://srgpc-certificate-system.onrender.com
